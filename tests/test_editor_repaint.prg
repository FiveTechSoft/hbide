#include "hbclass.ch"
#include "inkey.ch"
static nPass := 0, nFail := 0, cLog := ''
function HBIDE_MsgAlert( cText )
   HB_SYMBOL_UNUSED( cText )
return 1
class PaintProbe from HBSrcEdit
   data nLines init 0
   data nFull init 0
   method DisplayLine( n )
   method Display()
   method Dirty() inline ::lDirty
endclass
method DisplayLine( n ) class PaintProbe
   ::nLines++
return ::Super:DisplayLine( n )
method Display() class PaintProbe
   ::nFull++
return ::Super:Display()
procedure Check( cName, lOk )
   local h
   if lOk
      nPass++
   else
      nFail++
      hb_MemoWrit( '/tmp/hbide-repaint-failure.txt', cName )
   endif
   cLog += iif( lOk, 'PASS ', 'FAIL ' ) + cName + hb_eol()
return
procedure Main()
   // the IDE drives the editor in insert mode; the Harbour default for
   // SET(_SET_INSERT) is .F., so pin it explicitly for the hot-path checks
   local o := PaintProbe():New( 'local a := 1' + hb_eol() + 'return a', 2, 1, 20, 79, .T. )
   local cText, oOther
   Set( _SET_INSERT, .T. )
   o:GoTo( 1, 5 )
   o:nLines := o:nFull := 0
   o:Edit( Asc( 'x' ) )
   Check( 'ordinary char exactly one colored line', o:nLines == 1 .and. o:nFull == 0 )
   Check( 'ordinary char persisted', Left( o:GetText(), 1 ) == 'x' )
   o:Undo()
   Check( 'undo restores text', Left( o:GetText(), 5 ) == 'local' )
   o:Redo()
   Check( 'redo restores char', Left( o:GetText(), 1 ) == 'x' )
   o:LoadText( 'local a := 1' + hb_eol() + 'return a' )
   o:GoTo( 1, 5 )
   o:Edit( Asc( '/' ) )
   o:nLines := o:nFull := 0
   o:Edit( Asc( '*' ) )
   Check( 'comment opening full repaint', o:nFull >= 1 )
   Check( 'comment state propagates', o:BlkCmtState( 2 ) )
   o:Edit( Asc( '*' ) )
   o:nLines := o:nFull := 0
   o:Edit( Asc( '/' ) )
   Check( 'comment closing full repaint', o:nFull >= 1 )
   Check( 'comment closed below', ! o:BlkCmtState( 2 ) )
   o:LoadText( 'local alpha := 1' + hb_eol() + 'local beta := 2' + hb_eol() + 'return alpha + beta' )
   o:GoTo( 1, 5 )
   o:Display()
   Inkey( 1 )
   o:Edit( Asc( '/' ) )
   o:Edit( Asc( '*' ) )
   Inkey( 1 )
   o:Display()
   Inkey( 1 )
   o:LoadText( Replicate( 'a', 200 ) )
   o:GoTo( 1, 205 )
   o:Edit( Asc( 'z' ) )
   Check( 'horizontal scroll preserves typed char', Right( o:GetText(), 1 ) == 'z' )
   o:LoadText( 'abcdef' )
   o:GoTo( 1, 5 )
   o:Edit( K_F8 )
   o:Edit( K_RIGHT )
   o:Edit( K_RIGHT )
   o:Edit( Asc( 'X' ) )
   hb_MemoWrit( '/tmp/hbide-selection-result.txt', o:GetText() )
   // F8 at col 5 + 2xRight selects 2 chars ('ab', end-exclusive); typing X
   // replaces exactly those. (The old 'Xdef' expectation only passed in
   // overtype mode, where the typed char ate one more.)
   Check( 'selection replaced not appended', o:GetText() == 'Xcdef' )
   o:LoadText( 'alpha beta' )
   o:SelectWord( 1, 8 )
   Check( 'word selection shares marked range', o:HasMark() .and. o:SelectionText() == 'beta' )
   o:Edit( Asc( 'Z' ) )
   Check( 'word typing replaces selection', o:GetText() == 'alpha Z' )
   o:Undo()
   Check( 'Undo word typing exact', o:GetText() == 'alpha beta' )
   o:SelectWord( 1, 8 )
   o:Edit( K_BS )
   Check( 'word Backspace removes exact word', o:GetText() == 'alpha ' )
   o:Undo()
   Check( 'Undo word Backspace exact', o:GetText() == 'alpha beta' )
   // Nav fast path: pure cursor keys repaint only the rows whose
   // current-line highlight changed; the old row is restored by the
   // nOldScrRow block, so K_DOWN paints exactly 2 lines, no full repaint.
   o:LoadText( 'line one' + hb_eol() + 'line two' + hb_eol() + 'line three' )
   o:GoTo( 1, 5 )
   o:nLines := o:nFull := 0
   o:Edit( K_DOWN )
   Check( 'K_DOWN paints old and new row only', o:nLines == 2 .and. o:nFull == 0 )
   Check( 'K_DOWN moved cursor', o:Row() == 3 )
   o:GoTo( 2, 6 )
   o:nLines := o:nFull := 0
   o:Edit( K_LEFT )
   Check( 'K_LEFT same row paints nothing', o:nLines == 0 .and. o:nFull == 0 )
   Check( 'K_LEFT moved cursor', o:Col() == 5 )
   // F8 range mark: the selection highlight spans lines, so nav keeps the
   // full tail (prev/cur/next plus the old-row pass).
   o:GoTo( 1, 5 )
   o:Edit( K_F8 )
   o:nLines := o:nFull := 0
   o:Edit( K_DOWN )
   Check( 'K_DOWN with mark keeps full tail', o:nLines >= 3 )
   o:Edit( K_F8 )
   // Undo-op equality on the direct-PushOp hot path (insert/overtype/EOL
   // gap/multibyte/fusing/modified state/cursor): the direct op must behave
   // exactly like the snapshot+diff op it replaced.
   o:LoadText( 'abcde' )
   o:GoTo( 1, 7 )
   o:Edit( Asc( 'X' ) )
   Check( 'insert mid-line', o:GetText() == 'abXcde' )
   o:Undo()
   Check( 'undo insert restores', o:GetText() == 'abcde' )
   hb_MemoWrit( '/tmp/rpdbg.txt', hb_StrToHex( o:GetText() ) )
   Check( 'undo insert clean at saved state', ! o:Dirty() )
   o:Redo()
   Check( 'redo insert reapplies', o:GetText() == 'abXcde' )
   o:Undo()
   Set( _SET_INSERT, .F. )
   o:GoTo( 1, 6 )
   o:Edit( Asc( 'Y' ) )
   Set( _SET_INSERT, .T. )
   Check( 'overtype replaces char', o:GetText() == 'aYcde' )
   o:Undo()
   Check( 'undo overtype restores', o:GetText() == 'abcde' )
   o:GoTo( 1, 12 )
   o:Edit( Asc( 'z' ) )
   Check( 'typing past EOL pads spaces', o:GetText() == 'abcde  z' )
   o:Undo()
   Check( 'undo EOL gap restores exact', o:GetText() == 'abcde' )
   // a multibyte char arrives from a UTF-8 GT as an extended UNICODE key
   // (HB_INKEY_EXT_BIT + HB_INKEY_EXT_UNICODE + codepoint; gttrm.c:1374)
   hb_cdpSelect( 'UTF8' )
   o:GoTo( 1, 5 )
   o:Edit( 0x43000000 + 0xE9 )
   Check( 'multibyte char inserted', o:GetText() == 'éabcde' )
   o:Undo()
   Check( 'undo multibyte restores', o:GetText() == 'abcde' )
   o:GoTo( 1, 10 )
   o:Edit( Asc( '1' ) )
   o:Edit( Asc( '2' ) )
   o:Edit( Asc( '3' ) )
   Check( 'typing burst fuses', o:GetText() == 'abcde123' .and. Len( o:aUndo ) == 1 )
   o:Undo()
   Check( 'fused burst undoes in one op', o:GetText() == 'abcde' .and. ! o:Dirty() )
   Check( 'cursor lands on op row', o:Row() == 2 .and. o:Col() == 5 )
   o:ToggleBP()
   o:Edit( Asc( 'q' ) )
   Check( 'breakpoint survives hot-path edit', AScan( o:aBPs, 1 ) > 0 )
   o:Undo()
   Check( 'breakpoint survives undo', AScan( o:aBPs, 1 ) > 0 .and. o:GetText() == 'abcde' )
   o := PaintProbe():New( 'alpha', 2, 1, 20, 79, .T. )
   o:GoTo(1,5)
   o:Edit(Asc('X'))
   o:ReplaceAll('alpha','omega')
   Check('Replace is separate from earlier typing',Len(o:aUndo)==2.and.o:GetText()=='Xomega')
   o:Edit(Asc('Y'))
   o:Edit(Asc('Z'))
   Check('later typing fuses with itself not Replace',Len(o:aUndo)==3)
   o:Undo()
   Check('later typing Undo keeps replacement',o:GetText()=='Xomega')
   o:Undo()
   Check('replacement Undo keeps earlier typing',o:GetText()=='Xalpha')
   o:Undo()
   Check('earlier typing Undo returns clean original',o:GetText()=='alpha'.and.!o:Dirty())
   o:Redo()
   o:Redo()
   Check('redo retains command boundary',o:GetText()=='Xomega'.and.Len(o:aUndo)==2)
   o := PaintProbe():New('alpha',2,1,20,79,.T.)
   Check('identity Replace counts match without dirtying',o:ReplaceAll('alpha','alpha')==1.and.!o:Dirty().and.Empty(o:aUndo))
   o:GoTo(1,5)
   o:Edit(Asc('X'))
   o:Undo()
   Check('identity Replace preserves existing redo',o:ReplaceAll('alpha','alpha')==1.and.Len(o:aRedo)==1.and.!o:Dirty())
   o:Redo()
   Check('redo after identity Replace keeps earlier edit',o:GetText()=='Xalpha')
   o := PaintProbe():New('   '+Chr(13)+Chr(10)+'anchor',2,1,20,79,.T.)
   o:GoTo(1,5)
   o:CopyLine()
   o:GoTo(2,5)
   o:PasteLine()
   Check('space-only copied line pastes exact',o:GetText()=='   '+Chr(13)+Chr(10)+'anchor'+Chr(13)+Chr(10)+'   ')
   o:Undo()
   Check('space-only paste undo exact clean',o:GetText()=='   '+Chr(13)+Chr(10)+'anchor'.and.!o:Dirty())
   o:Redo()
   Check('space-only paste redo exact',o:GetText()=='   '+Chr(13)+Chr(10)+'anchor'+Chr(13)+Chr(10)+'   ')
   o := PaintProbe():New(Chr(9)+'  '+Chr(10)+'anchor',2,1,20,79,.T.)
   o:GoTo(1,5)
   o:CopyLine()
   o:GoTo(2,5)
   o:PasteLine()
   Check('tab-space copied line pastes exact',o:GetText()==Chr(9)+'  '+Chr(10)+'anchor'+Chr(10)+Chr(9)+'  ')
   o := PaintProbe():New('alpha'+hb_eol()+'beta'+hb_eol()+'gamma',2,1,20,79,.T.)
   o:GoTo(3,5)
   o:ToggleMark()
   o:GoTo(1,5)
   Check('selection before reload spans three lines',o:SelRange()!=NIL)
   o:LoadText('fresh')
   Check('shorter LoadText clears old selection anchor',!o:HasMark().and.o:SelRange()==NIL)
   o:GoTo(1,5)
   o:Edit(Asc('X'))
   Check('typing after shorter LoadText exact',o:GetText()=='Xfresh')
   o:Undo()
   Check('typing after shorter LoadText undo clean',o:GetText()=='fresh'.and.!o:Dirty())
   o := PaintProbe():New('alpha'+hb_eol()+'beta'+hb_eol()+'gamma',2,1,20,79,.T.)
   o:GoTo(3,5)
   o:ToggleMark()
   o:GoTo(1,5)
   o:DeleteLine()
   Check('Delete Line clears old multirow selection',!o:HasMark().and.o:GetText()=='beta'+hb_eol()+'gamma')
   o:Edit(Asc('X'))
   Check('typing after Delete Line exact',o:GetText()=='Xbeta'+hb_eol()+'gamma')
   o:Undo()
   Check('typing Undo keeps Delete Line',o:GetText()=='beta'+hb_eol()+'gamma')
   o:Undo()
   Check('Delete Line Undo restores clean source',o:GetText()=='alpha'+hb_eol()+'beta'+hb_eol()+'gamma'.and.!o:Dirty())
   o := PaintProbe():New('alpha',2,1,20,79,.T.)
   Set(_SET_INSERT,.F.)
   o:GoTo(1,5)
   o:Edit(Asc('a'))
   Check('identical overtype advances without dirty/history',o:GetText()=='alpha'.and.o:Col()==6.and.!o:Dirty().and.Empty(o:aUndo))
   o:Edit(Asc('X'))
   Check('different overtype still dirties',o:GetText()=='aXpha'.and.o:Dirty())
   o:Undo()
   o:GoTo(1,5)
   o:Edit(Asc('a'))
   Check('identical overtype preserves redo and clean',!o:Dirty().and.Len(o:aRedo)==1)
   o:Redo()
   Check('redo after identical overtype exact',o:GetText()=='aXpha')
   Set(_SET_INSERT,.T.)
   o := PaintProbe():New('alpha'+hb_eol()+'beta'+hb_eol()+'gamma',2,1,20,79,.T.)
   o:GoTo(3,5)
   o:ToggleMark()
   o:GoTo(1,5)
   o:DuplicateLine()
   Check('Duplicate Line clears earlier multirow selection',!o:HasMark())
   o:Edit(Asc('X'))
   Check('typing after Duplicate Line preserves source block',o:GetText()=='alpha'+hb_eol()+'Xalpha'+hb_eol()+'beta'+hb_eol()+'gamma')
   o:Undo()
   Check('typing Undo keeps Duplicate Line',o:GetText()=='alpha'+hb_eol()+'alpha'+hb_eol()+'beta'+hb_eol()+'gamma')
   o:Undo()
   Check('Duplicate Line Undo restores clean source',o:GetText()=='alpha'+hb_eol()+'beta'+hb_eol()+'gamma'.and.!o:Dirty())
   o := PaintProbe():New('alpha',2,1,20,79,.T.)
   o:GoTo(1,5)
   o:CopyLine()
   oOther := PaintProbe():New('beta',2,1,20,79,.T.)
   oOther:GoTo(1,5)
   oOther:PasteLine()
   Check('clipboard crosses editor instances',oOther:GetText()=='beta'+hb_eol()+'alpha')
   Check('cross-document Paste leaves source clean',o:GetText()=='alpha'.and.!o:Dirty().and.Empty(o:aUndo))
   oOther:Undo()
   Check('cross-document Paste Undo isolated',oOther:GetText()=='beta'.and.o:GetText()=='alpha')
   oOther:Redo()
   Check('cross-document Paste Redo exact',oOther:GetText()=='beta'+hb_eol()+'alpha')
   o := PaintProbe():New('alpha',2,1,20,79,.T.)
   o:GoTo(1,5)
   o:ToggleMark()
   o:GoTo(1,7)
   o:ReplaceAll('alpha','omega')
   Check('Replace clears selection from old text',!o:HasMark())
   o:Edit(Asc('X'))
   Check('typing after Replace does not delete stale range',o:GetText()=='omXega')
   o:Undo()
   Check('typing Undo retains replacement after selected Replace',o:GetText()=='omega')
   o:Undo()
   Check('selected Replace Undo restores clean source',o:GetText()=='alpha'.and.!o:Dirty())
   o := PaintProbe():New('alpha',2,1,20,79,.T.)
   o:GoTo(1,5)
   o:Edit(Asc('X'))
   o:GoTo(1,6)
   o:ToggleMark()
   o:GoTo(1,8)
   o:CutSelection()
   Check('Cut is separate from earlier typing',o:GetText()=='Xpha'.and.Len(o:aUndo)==2)
   o:Edit(Asc('Y'))
   Check('later typing is separate from Cut',Len(o:aUndo)==3)
   o:Undo()
   Check('later typing Undo keeps Cut',o:GetText()=='Xpha')
   o:Undo()
   Check('Cut Undo keeps earlier typing',o:GetText()=='Xalpha')
   o:Undo()
   Check('preCut typing Undo restores clean source',o:GetText()=='alpha'.and.!o:Dirty())
   o := PaintProbe():New('alpha',2,1,20,79,.T.)
   o:GoTo(1,5)
   o:Edit(Asc('X'))
   o:GoTo(1,6)
   o:ToggleMark()
   o:GoTo(1,8)
   o:Edit(Asc('Y'))
   Check('selected typing keeps earlier typing separate',o:GetText()=='XYpha'.and.Len(o:aUndo)==2)
   o:Edit(Asc('Z'))
   Check('typing after selected replacement separate',Len(o:aUndo)==3)
   o:Undo()
   Check('later typing Undo keeps selected replacement',o:GetText()=='XYpha')
   o:Undo()
   Check('selected replacement Undo keeps earlier typing',o:GetText()=='Xalpha')
   o:Redo()
   Check('selected replacement Redo exact',o:GetText()=='XYpha')
   o:Undo()
   o:Undo()
   Check('before selected replacement Undo restores clean source',o:GetText()=='alpha'.and.!o:Dirty())
   o := PaintProbe():New('alpha',2,1,20,79,.T.)
   o:GoTo(1,5)
   o:Edit(Asc('X'))
   o:GoTo(1,6)
   o:ToggleMark()
   o:GoTo(1,8)
   o:Edit(K_DEL)
   o:Undo()
   Check('marked Delete Undo keeps earlier typing',o:GetText()=='Xalpha')
   o:Redo()
   Check('marked Delete Redo exact',o:GetText()=='Xpha')
   o:Undo()
   o:ToggleMark()
   o:GoTo(1,8)
   o:Edit(K_BS)
   o:Undo()
   Check('marked Backspace Undo keeps earlier typing',o:GetText()=='Xalpha')
   o := PaintProbe():New( 'one two three', 2, 1, 20, 79, .T., 16 )
   o:GoTo( 1, 5 )
   o:Edit( Asc( 'Z' ) )
   Check( 'wordwrap path preserves typed character', Left( o:GetText(), 1 ) == 'Z' )
   hb_MemoWrit( '/tmp/rpall.txt', cLog )
   hb_MemoWrit( '/tmp/hbide-repaint-tests.txt', 'PASS ' + hb_ntos( nPass ) + ' FAIL ' + hb_ntos( nFail ) )
   if nFail > 0
      ErrorLevel( 1 )
   endif
return
