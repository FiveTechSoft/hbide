REQUEST HB_CODEPAGE_UTF8
#include "hbclass.ch"
#include "inkey.ch"
static nPass:=0,nFail:=0
procedure Main()
 local o:=HBSrcEdit():New('',2,1,20,79,.T.)
 hb_cdpSelect('UTF8')
 Set(_SET_INSERT,.T.)
 o:LoadText('café beta')
 o:GoTo(1,5)
 o:Edit(K_CTRL_T)
 Check('UTF8 word removes whole accented word',o:GetText()==' beta')
 o:Undo()
 Check('UTF8 Undo restores exact',o:GetText()=='café beta')
 o:GoTo(1,8)
 o:Edit(K_CTRL_T)
 Check('UTF8 midword deletes one scalar not byte',o:GetText()=='caf beta')
 o:Undo()
 o:LoadText(Chr(9)+'alpha beta')
 o:GoTo(1,6)
 o:Edit(K_CTRL_T)
 Check('TAB is one model column, not display width',o:GetText()==Chr(9)+' beta')
 o:Undo()
 Check('TAB Undo exact',o:GetText()==Chr(9)+'alpha beta')
 o:LoadText('/* comment'+Chr(10)+'return nil')
 Check('initial block comment reaches next row',o:BlkCmtState(2))
 o:GoTo(1,5)
 o:Edit(K_CTRL_T)
 Check('word deletion invalidates block state',!o:BlkCmtState(2))
 o:Undo()
 Check('Undo restores block state',o:BlkCmtState(2))
 o:Redo()
 Check('Redo clears block state',!o:BlkCmtState(2))
 o:LoadText('alpha beta gamma')
 o:GoTo(1,5)
 o:Edit(K_F8)
 o:GoTo(1,11)
 o:Edit(K_CTRL_T)
 Check('CtrlT consumes marked range before word at cursor',o:GetText()=='beta gamma'.and.!o:HasMark())
 o:Undo()
 Check('marked CtrlT Undo exact',o:GetText()=='alpha beta gamma')
 o:Redo()
 Check('marked CtrlT Redo exact',o:GetText()=='beta gamma')
 o:Edit(Asc('X'))
 Check('typing after CtrlT has no stale selection',o:GetText()=='Xbeta gamma')
 o:LoadText('alpha'+Chr(9)+'beta gamma')
 o:GoTo(1,5)
 o:Edit(K_CTRL_T)
 Check('CtrlT raw TAB separates words',o:GetText()==Chr(9)+'beta gamma')
 o:Undo()
 Check('TAB boundary Undo exact',o:GetText()=='alpha'+Chr(9)+'beta gamma')
 o:Redo()
 Check('TAB boundary Redo exact',o:GetText()==Chr(9)+'beta gamma')
 o:LoadText(Chr(9)+'alpha'+Chr(9)+'beta')
 o:GoTo(1,5)
 o:Edit(K_CTRL_T)
 Check('leading TAB skipped before current word',o:GetText()==Chr(9)+'beta')
 o:Undo()
 Check('leading TAB Undo exact',o:GetText()==Chr(9)+'alpha'+Chr(9)+'beta')
 o:LoadText('abcdefghij'+hb_eol()+'x')
 o:cClipboard := 'CLIP'
 o:GoTo(1,5)
 o:Edit(Asc('X'))
 o:Undo()
 o:GoTo(2,15)
 o:Edit(K_CTRL_T)
 Check('virtual CtrlT keeps bytes dirty and history unchanged',o:GetText()=='abcdefghij'+hb_eol()+'x'.and.!o:Changed().and.Empty(o:aUndo).and.Len(o:aRedo)==1)
 Check('virtual CtrlT preserves clipboard and cursor',o:cClipboard=='CLIP'.and.o:Col()==15)
 o:Redo()
 Check('Redo survives virtual CtrlT',o:GetText()=='Xabcdefghij'+hb_eol()+'x')
 o:Undo()
 o:LoadText('')
 o:Edit(K_CTRL_T)
 Check('empty CtrlT no dirty/history',o:GetText()==''.and.!o:Changed().and.Empty(o:aUndo))
 ? 'TOTAL',nPass,'PASS',nFail,'FAIL'
 ErrorLevel(iif(nFail==0,0,1))
return
procedure Check(c,l)
 if l
 nPass++
 else
 nFail++
 endif
 ? iif(l,'PASS ','FAIL ')+c
return
function HBIDE_MsgAlert(c)
 HB_SYMBOL_UNUSED(c)
return 1
