PROCEDURE Main( cHbmk2 )
   LOCAL oP := HBIDEProject():New(), a, cTmp := hb_DirTemp() + 'hbide-project-tests/', cBefore, cCwd := hb_cwd(), cInc, cOldInc := GetEnv( "HB_INC_INSTALL" )
   cInc := HBIDECompilerInclude()
   Assert( File( cInc + "inkey.ch" ), "discover standard headers from compiler PATH" )
   hb_DirBuild( cTmp + "sdk include/" )
   hb_MemoWrit( cTmp + "sdk include/inkey.ch", "// probe" )
   hb_MemoWrit( cTmp + "sdk include/hbclass.ch", "// probe" )
   hb_MemoWrit( cTmp + "sdk include/std.ch", "// probe" )
   hb_SetEnv( "HB_INC_INSTALL", cTmp + "sdk include" )
   Assert( HBIDECompilerInclude() == hb_DirSepAdd( cTmp + "sdk include" ), "explicit include override wins" )
   hb_SetEnv( "HB_INC_INSTALL", cTmp + "missing" )
   Assert( HBIDECompilerInclude() == cInc, "invalid include override falls back to PATH" )
   hb_SetEnv( "HB_INC_INSTALL", cOldInc )
   hb_DirBuild( cTmp + 'include/' )
   hb_MemoWrit( cTmp + 'app.hbp', 'main.prg second.prg' + hb_eol() + '-iinclude' + hb_eol() + '-oapp' + hb_eol() + '-gtstd' + hb_eol() )
   hb_MemoWrit( cTmp + 'include/values.ch', '#define START_VALUE 3' + hb_eol() )
   hb_MemoWrit( cTmp + 'main.prg', '#include "values.ch"' + hb_eol() + 'procedure Main()' + hb_eol() + ;
      'hb_MemoWrit( "ran.txt", hb_ntos( Compute( START_VALUE ) ) )' + hb_eol() + 'return' )
   hb_MemoWrit( cTmp + 'second.prg', 'function Compute( n )' + hb_eol() + 'return n + 6' )
   Assert( oP:Open( cTmp + 'app.hbp' ), 'open existing hbp' )
   Assert( Len( oP:aMembers ) == 2, 'two project sources' )
   Assert( hb_FileExists( oP:aMembers[ 2, 'path' ] ), 'source path resolved' )
   cBefore := oP:cOriginal
   Assert( oP:Info( cHbmk2 ), 'hbinfo succeeds' )
   Assert( oP:hInfo[ 'targettype' ] == 'hbexe', 'hbinfo targettype' )
   Assert( oP:Build( cHbmk2, .F. ), 'two files + ch build' )
   Assert( oP:hBuild[ 'exit' ] == 0, 'build exit zero' )
   Assert( ! hb_FileExists( cTmp + 'ran.txt' ), 'build never runs executable' )
   Assert( hb_FileExists( cTmp + 'app' ), 'build output created' )
   hb_MemoWrit( cTmp + 'second.prg', 'function Compute( n )' + hb_eol() + 'return n +' + hb_eol() )
   Assert( ! oP:Build( cHbmk2, .T. ), 'syntax error fails' )
   Assert( oP:hBuild[ 'exit' ] != 0, 'nonzero exit authoritative' )
   Assert( Len( oP:hBuild[ 'diagnostics' ] ) >= 1, 'diagnostic parsed' )
   Assert( oP:hBuild[ 'diagnostics', 1, 'line' ] == 2, 'error line correct' )
   Assert( oP:hBuild[ 'diagnostics', 1, 'path' ] == cTmp + 'second.prg', 'error source correct' )
   Assert( ! hb_FileExists( cTmp + 'ran.txt' ), 'failed build never runs stale app' )
   Assert( hb_MemoRead( oP:cFile ) == cBefore, 'hbp byte preserved' )
   Assert( hb_cwd() == cCwd, 'working directory restored' )
   a := HBIDEProjectDiagnostics( 'C:\src\calc.c:12:7: error: wrong type' + hb_eol() + ;
      'space dir/file.prg(99) Warning W0001 Suspicious' + hb_eol() + 'other output', cTmp )
   Assert( Len( a ) == 2, 'gcc and Harbour diagnostics' )
   Assert( a[ 1, 'line' ] == 12 .AND. a[ 1, 'column' ] == 7, 'gcc line and column' )
   Assert( a[ 1, 'path' ] == 'C:\src\calc.c', 'windows drive preserved' )
   a := HBIDEProjectDiagnostics( 'folder (old)/test.prg(12) Error E0030 Syntax error', cTmp )
   Assert( Len( a ) == 1, 'Harbour diagnostic under parenthesized path parsed' )
   Assert( a[ 1, 'path' ] == cTmp + 'folder (old)/test.prg' .AND. a[ 1, 'line' ] == 12, 'parenthesized path and error line exact' )
   a := HBIDEProjectDiagnostics( 'folder (12)/test(3).prg(7) Warning W0001 Test', cTmp )
   Assert( Len( a ) == 1 .AND. a[ 1, 'path' ] == cTmp + 'folder (12)/test(3).prg' .AND. a[ 1, 'line' ] == 7, 'numeric parentheses in path are not source lines' )
   a := HBIDEProjectDiagnostics( ' leading.prg(2) Error E0030 Syntax error', cTmp )
   Assert( Len( a ) == 1 .AND. a[ 1, 'path' ] == cTmp + ' leading.prg', 'Harbour diagnostic preserves leading source space' )
   a := HBIDEProjectDiagnostics( 'folder:12:part/bad.c:2:9: error: undeclared' + hb_eol() + ;
      'folder:12:part/bad.c:2:9: note: error is reported once' + hb_eol() + ;
      'other.c:7: warning: text mentions error', cTmp )
   Assert( Len(a)==2, 'GCC note/context not promoted to error' )
   Assert( a[1,'path']==cTmp+'folder:12:part/bad.c'.and.a[1,'line']==2.and.a[1,'column']==9, 'numeric colon path preserved and actual location chosen' )
   Assert( a[2,'level']=='warning'.and.a[2,'line']==7.and.a[2,'column']==1, 'severity prefix wins over message words and no column supported' )
   a := HBIDEProjectDiagnostics('bad.c:3:4: fatal error: missing header',cTmp)
   Assert(Len(a)==1.and.a[1,'level']=='error','GCC fatal error retained')
   hb_MemoWrit(cTmp+'caret.c','int main(void) {'+hb_eol()+Chr(9)+'return unknown_name;'+hb_eol()+'}')
   Assert(HBIDEProjectCaretColumn(cTmp+'caret.c',2,16,'    2 |         return unknown_name;','      |                ^~~~~~~~~~~~')==9,'GCC default caret maps tab to char')
   Assert(HBIDEProjectCaretColumn(cTmp+'caret.c',2,9,'    2 |         return unknown_name;','      |                ^~~~~~~~~~~~')==9,'byte column plus visual caret stays correct')
   Assert(HBIDEProjectCaretColumn(cTmp+'caret.c',2,12,'    2 |     return unknown_name;','      |            ^~~~~~~~~~~~')==9,'custom tab4 caret maps')
   Assert(HBIDEProjectCaretColumn(cTmp+'caret.c',2,24,'    2 |                 return unknown_name;','      |                        ^~~~~~~~~~~~')==9,'custom tab16 caret maps')
   Assert(HBIDEProjectCaretColumn(cTmp+'caret.c',2,16,'','')==16,'absent caret preserves reported column')
   Assert(HBIDEProjectCaretColumn(cTmp+'caret.c',2,16,'    2 | return different;','      |        ^')==16,'source mismatch preserves reported column')
   Assert(HBIDEProjectCaretColumn(cTmp+'caret.c',2,16,'    3 |         return unknown_name;','      |                ^')==16,'wrong row snippet preserves column')
   Assert(HBIDEProjectCaretColumn(cTmp+'caret.c',2,16,'    2 |         return unknown_name;','      |                ^^')==16,'multiple carets not guessed')
   Assert(HBIDEProjectCaretColumn(cTmp+'caret.c',2,16,'    2 |         return unknown_name;','      |       text     ^')==16,'non-marker text rejected')
   hb_MemoWrit(cTmp+'caret.c','int main(void) {'+hb_eol()+Chr(9)+'return '+Chr(195)+Chr(169)+';'+hb_eol()+'}')
   Assert(HBIDEProjectCaretColumn(cTmp+'caret.c',2,16,'    2 |         return '+Chr(195)+Chr(169)+';','      |                ^')==16,'non-ASCII source not guessed')
   hb_MemoWrit(cTmp+'caret.c',Replicate('x',30000))
   Assert(HBIDEProjectCaretColumn(cTmp+'caret.c',1,16,'    1 | '+Replicate('x',30000),'      |                ^')==16,'long no-tab ASCII caret exact')
   Assert(HBIDEProjectCaretColumn(cTmp+'missing.c',1,9,'','')==9,'missing evidence never needs source read')
   a := HBIDEProjectDiagnostics(Chr(27)+'[01m'+cTmp+'bad.c:2:9:'+Chr(27)+'[m'+Chr(27)+'[K '+Chr(27)+'[31merror: bad'+Chr(27)+'[m',cTmp)
   Assert(Len(a)==1.and.a[1,'path']==cTmp+'bad.c'.and.a[1,'line']==2.and.a[1,'column']==9,'GCC colored location/severity parsed without ANSI path')
   Assert(Chr(27)$a[1,'raw'].and.!Chr(27)$a[1,'text'],'raw colored diagnostic retained, display message plain')
   a := HBIDEProjectTokens( '"folder with space/test.prg" -iinclude' )
   Assert( Len( a ) == 2 .AND. a[ 1 ] == 'folder with space/test.prg', 'quoted member' )
   a := HBIDEProjectTokens( 'first "" "two words" "" last' )
   Assert( Len( a ) == 5 .AND. a[ 2 ] == '' .AND. a[ 3 ] == 'two words' .AND. a[ 4 ] == '', 'empty quoted argument positions preserved' )
   a := HBIDEProjectTokens( '  """"  ' )
   Assert( Len( a ) == 1 .AND. a[ 1 ] == '', 'adjacent quotes remain one empty word' )
   Assert( HBIDEProjectTokens( '"unbalanced' ) == NIL, 'bad quote retained as unresolved' )
   hb_MemoWrit(cTmp+'bom.hbp',Chr(239)+Chr(187)+Chr(191)+'main.prg'+hb_eol()+'-gtstd')
   Assert(oP:Open(cTmp+'bom.hbp').and.Len(oP:aMembers)==1,'BOM project opens and lists literal source')
   Assert(oP:aMembers[1,'path']==cTmp+'main.prg'.and.oP:aMembers[1,'exists'],'BOM excluded from actual member path')
   Assert(Left(oP:cOriginal,3)==Chr(239)+Chr(187)+Chr(191).and.oP:cOriginal==hb_MemoRead(cTmp+'bom.hbp'),'BOM HBP original preserved byteexact')
   hb_MemoWrit(cTmp+'eof.hbp','-gtstd'+hb_eol()+'main.prg'+Chr(26))
   Assert(oP:Open(cTmp+'eof.hbp').and.Len(oP:aMembers)==1,'final DOS EOF does not hide last source')
   Assert(oP:aMembers[1,'path']==cTmp+'main.prg'.and.oP:aMembers[1,'exists'],'EOF excluded from actual member path')
   Assert(Right(oP:cOriginal,1)==Chr(26).and.oP:cOriginal==hb_MemoRead(cTmp+'eof.hbp'),'EOF HBP original preserved byteexact')
   hb_MemoWrit(cTmp+'embedded-eof.hbp','main'+Chr(26)+'.prg'+hb_eol())
   Assert(oP:Open(cTmp+'embedded-eof.hbp').and.Len(oP:aMembers)==1.and.oP:aMembers[1,'token']=='main'+Chr(26)+'.prg','embedded EOF not stripped or guessed')
   hb_MemoWrit(cTmp+'cxx.hbp','helper.cc helper.cxx helper.cx helper.cpp'+hb_eol())
   hb_MemoWrit(cTmp+'helper.cc','int helper() { return 42; }')
   Assert(oP:Open(cTmp+'cxx.hbp').and.Len(oP:aMembers)==4,'all hbmk2 C++ source extensions inventoried')
   Assert(oP:aMembers[1,'exists'].and.oP:aMembers[1,'kind']=='source','cc source resolves existing file')
   Assert(!oP:aMembers[2,'exists'].and.oP:aMembers[2,'token']=='helper.cxx','missing cxx remains visible not guessed')
   Assert(oP:cOriginal==hb_MemoRead(cTmp+'cxx.hbp'),'C++ extension inventory preserves project bytes')
   hb_MemoWrit(cTmp+'hpp.hbp','values.hpp missing.hpp'+hb_eol())
   hb_MemoWrit(cTmp+'values.hpp','#define VALUE 42')
   Assert(oP:Open(cTmp+'hpp.hbp').and.Len(oP:aMembers)==2,'literal hpp headers inventoried')
   Assert(oP:aMembers[1,'exists'].and.oP:aMembers[1,'kind']=='source'.and.oP:aMembers[1,'path']==cTmp+'values.hpp','hpp header resolves exact existing path')
   Assert(!oP:aMembers[2,'exists'].and.oP:cOriginal==hb_MemoRead(cTmp+'hpp.hbp'),'missing hpp visible and project bytes preserved')
   hb_MemoWrit(cTmp+'hh.hbp','values.hh missing.hh'+hb_eol())
   hb_MemoWrit(cTmp+'values.hh','#define VALUE 42')
   Assert(oP:Open(cTmp+'hh.hbp').and.Len(oP:aMembers)==2,'literal hh headers inventoried')
   Assert(oP:aMembers[1,'exists'].and.oP:aMembers[1,'kind']=='source'.and.oP:aMembers[1,'path']==cTmp+'values.hh','hh header resolves exact existing path')
   Assert(!oP:aMembers[2,'exists'].and.oP:cOriginal==hb_MemoRead(cTmp+'hh.hbp'),'missing hh visible and project bytes preserved')
   hb_MemoWrit(cTmp+'plain.hbp','main missing "space dir/test file" -gtstd'+hb_eol())
   Assert(oP:Open(cTmp+'plain.hbp').and.Len(oP:aMembers)==3,'extensionless literal inputs inventoried with compiler default')
   Assert(oP:aMembers[1,'path']==cTmp+'main.prg'.and.oP:aMembers[1,'token']=='main'.and.oP:aMembers[1,'exists'],'defaultprg path resolved but original token retained')
   Assert(!oP:aMembers[2,'exists'].and.oP:aMembers[2,'path']==cTmp+'missing.prg','extensionless missing source remains visible')
   Assert(oP:aMembers[3,'path']==cTmp+'space dir/test file.prg'.and.oP:cOriginal==hb_MemoRead(cTmp+'plain.hbp'),'quoted extensionless source and projectbytes preserved')
   hb_MemoWrit(cTmp+'duplicate-default.hbp','main main.prg missing "" -run -oout @opts {win}other *.prg'+hb_eol())
   Assert(oP:Open(cTmp+'duplicate-default.hbp').and.Len(oP:aMembers)==2,'defaultprg deduplicates explicit path and skips empty flags')
   Assert(oP:aMembers[1,'token']=='main'.and.oP:aMembers[2,'token']=='missing','defaultprg retains first literal provenance')
   Assert(Len(oP:aUnresolved)==3,'defaultprg does not evaluate response files filters wildcards')
   Assert(!hb_FileExists(cTmp+'ran-on-open.txt'),'defaultprg inventory performs no execution')
   hb_MemoWrit( cTmp + 'complex.hbp' , '# preserved comment' + hb_eol() + ;
      '"folder with space/test.prg" {win}windows.prg ${CUSTOM}/foo.prg *.prg @opts.hbm' )
   Assert( oP:Open( cTmp + 'complex.hbp' ), 'complex hbp open' )
   Assert( Len( oP:aUnresolved ) == 4, 'no guessed filters macros wildcards includes' )
   Assert( Len( oP:aMembers ) == 1, 'literal member retained' )
   Assert( ! oP:aMembers[ 1, 'exists' ], 'missing source visibly marked' )
   hb_DirBuild( cTmp + 'space dir/' )
   hb_MemoWrit( cTmp + 'space dir/test file.prg', 'procedure Main()' + hb_eol() + ;
      'hb_MemoWrit( "ran.txt", "UNEXPECTED" )' + hb_eol() + 'return' )
   hb_MemoWrit( cTmp + 'space dir/space app.hbp', '"test file.prg"' + hb_eol() + '-gtstd' + hb_eol() + '-run' )
   Assert( oP:Open( cTmp + 'space dir/space app.hbp' ), 'spaced project open' )
   Assert( oP:Build( cHbmk2, .F. ), 'spaced project and source build' )
   Assert( ! hb_FileExists( cTmp + 'space dir/ran.txt' ), '-run in hbp overridden' )
   Assert( ! oP:Build( cTmp + 'no such hbmk2', .F. ), 'missing compiler fails' )
   Assert( hb_cwd() == cCwd, 'cwd restored after failed process' )
   Assert( ! oP:Open( cTmp + 'missing.hbp' ), 'missing project rejected' )
   Assert( Empty( oP:cFile ), 'failed open cannot retain previous project' )
   hb_MemoWrit( '/tmp/hbide-project-tests.txt', 'PASS hbp inventory/info/build/diagnostics/failedbuild/noautorun/bytepreservation/cwd/quotes/filters' )
   RETURN
PROCEDURE Assert( lOk, cName )
   IF ! lOk
      hb_MemoWrit( '/tmp/hbide-project-tests.txt', 'FAIL ' + cName )
      ErrorLevel( 1 )
      QUIT
   ENDIF
   RETURN
