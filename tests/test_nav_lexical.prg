procedure Main()
 local a, c, nPass:=0,nFail:=0
 a:=HBIDE_ScanProcs('function Main()'+hb_eol()+'local n := a /* gap'+hb_eol()+'*/ [1 /* ] real'+hb_eol()+'function Hidden()'+hb_eol()+'*/ ]'+hb_eol()+'function Target()')
 Check(Len(a)==2.and.a[2,1]=='Target'.and.a[2,3]==6,'multiline gap carries value index context',@nPass,@nFail)
 a:=HBIDE_ScanProcs('function Main()'+hb_eol()+'local c := /* gap'+hb_eol()+'*/ [/* literal]'+hb_eol()+'function Target()')
 Check(Len(a)==2.and.a[2,1]=='Target','multiline gap carries literal introducer',@nPass,@nFail)
 a:=HBIDE_ScanProcs('function Main()'+hb_eol()+'a /* gap'+hb_eol()+'*/ [1]'+hb_eol()+'local c := [/* literal]'+hb_eol()+'function Target()')
 Check(Len(a)==2.and.a[2,1]=='Target','closed block carry resets on next physical line',@nPass,@nFail)
 for each c in { "local c := `/* literal'", 'local c := "/*"', "local c := '/*'", 'local c := [/*]', '// /*', '&& /*', '* /*', 'local c := "//" // /*', 'local c := "&&" && /*' }
 a:=HBIDE_ScanProcs('function Main()'+hb_eol()+c+hb_eol()+'return nil'+hb_eol()+'function Target()'+hb_eol()+'return nil')
 Check(Len(a)==2.and.a[2,1]=='Target'.and.a[2,3]==4,'literal or linecomment does not startblock: '+c,@nPass,@nFail)
 next
 a:=HBIDE_ScanProcs('/* function Hidden()'+hb_eol()+'procedure Hidden2() */ function Real()'+hb_eol()+'return nil')
 Check(Len(a)==1.and.a[1,1]=='Real'.and.a[1,3]==2,'realblock and declaration after closing marker',@nPass,@nFail)
 a:=HBIDE_ScanProcs('function Main() // /*'+hb_eol()+'return nil'+hb_eol()+'function Other()')
 Check(Len(a)==2.and.a[2,1]=='Other','trailinglinecomment opener ignored',@nPass,@nFail)
 a:=HBIDE_ScanProcs('#pragma begindump'+hb_eol()+'function Cnoise()'+hb_eol()+'#pragma enddump'+hb_eol()+'function Harbour()')
 Check(Len(a)==1.and.a[1,1]=='Harbour'.and.a[1,3]==4,'C dump excluded',@nPass,@nFail)
 a:=HBIDE_ScanProcs('#pragma begindump'+hb_eol()+'/* C comment'+hb_eol()+'#pragma enddump'+hb_eol()+'function Harbour()')
 Check(Len(a)==1.and.a[1,1]=='Harbour'.and.a[1,3]==4,'dump comment state stays outside Harbour lexer',@nPass,@nFail)
 a:=HBIDE_ScanProcs('CLASS Demo'+hb_eol()+' CLASS VAR shared INIT 1'+hb_eol()+' CLASS METHOD Ping()'+hb_eol()+'ENDCLASS'+hb_eol()+'METHOD FUNCTION New() CLASS Demo'+hb_eol()+'METHOD PROCEDURE Touch() CLASS Demo')
 Check(Len(a)==3,'class members are not class declarations',@nPass,@nFail)
 Check(a[2,1]=='Demo:New'.and.a[2,3]==5,'typed function method name and line',@nPass,@nFail)
 Check(a[3,1]=='Demo:Touch'.and.a[3,3]==6,'typed procedure method name and line',@nPass,@nFail)
 a:=HBIDE_ScanProcs('function Main()'+hb_eol()+'local n := a[1 /* realblock'+hb_eol()+'function Hidden()'+hb_eol()+'*/ ]'+hb_eol()+'return n'+hb_eol()+'function Target()')
 Check(Len(a)==2.and.a[2,1]=='Target'.and.a[2,3]==6,'array index multiline block excludes hidden declaration',@nPass,@nFail)
 a:=HBIDE_ScanProcs('#define TEXT #pragma begindump'+hb_eol()+'function Main()'+hb_eol()+'return nil'+hb_eol()+'function Target()')
 Check(Len(a)==2.and.a[2,1]=='Target'.and.a[2,3]==4,'macro body is not an active dump directive',@nPass,@nFail)
 for each c in { '#pragma enddump // done', '# pragma enddump && done', '#pragma'+Chr(9)+'enddump /* done */', '#pragma enddump;' }
 a:=HBIDE_ScanProcs('#pragma begindump'+hb_eol()+'/* C comment'+hb_eol()+c+hb_eol()+'function Harbour()')
 Check(Len(a)==1.and.a[1,1]=='Harbour'.and.a[1,3]==4,'commented/separated raw enddump resumes Harbour: '+c,@nPass,@nFail)
 next
 for each c in { '#pragma enddumpExtra', '#pragmaenddump', '// #pragma enddump', '#pragma enddump bad' }
 a:=HBIDE_ScanProcs('#pragma begindump'+hb_eol()+c+hb_eol()+'function Hidden()'+hb_eol()+'#pragma enddump'+hb_eol()+'function Real()')
 Check(Len(a)==1.and.a[1,1]=='Real'.and.a[1,3]==5,'nonterminator does not leak C text: '+c,@nPass,@nFail)
 next
 for each c in { 'local n := a[1 /* ] marker', 'local n := a [1 /* ] marker', 'local n := GetArray()[1 /* ] marker' }
 a:=HBIDE_ScanProcs('function Main()'+hb_eol()+c+hb_eol()+'function Hidden()'+hb_eol()+'*/ ]'+hb_eol()+'function Target()')
 Check(Len(a)==2.and.a[2,1]=='Target'.and.a[2,3]==5,'index comment with closing bracket is not literal: '+c,@nPass,@nFail)
 next
 a:=HBIDE_ScanProcs('function Main()'+hb_eol()+'return [/* literal]'+hb_eol()+'function Target()')
 Check(Len(a)==2.and.a[2,1]=='Target','RETURN bracket literal remains masked',@nPass,@nFail)
 for each c in { 'local n := a /* gap */ [1 /* ] marker', 'local n := a /* first */ /* next */ [1 /* ] marker', 'local n := GetArray() /* gap */ [1 /* ] marker', 'local n := "array value" /* gap */ [1 /* ] marker' }
 a:=HBIDE_ScanProcs('function Main()'+hb_eol()+c+hb_eol()+'function Hidden()'+hb_eol()+'*/ ]'+hb_eol()+'function Target()')
 Check(Len(a)==2.and.a[2,1]=='Target'.and.a[2,3]==5,'completed comment preserves preceding index value: '+c,@nPass,@nFail)
 next
 a:=HBIDE_ScanProcs('function Main()'+hb_eol()+'return /* gap */ [/* literal]'+hb_eol()+'function Target()')
 Check(Len(a)==2.and.a[2,1]=='Target','RETURN with completed comment still introduces bracket literal',@nPass,@nFail)
 a:=HBIDE_ScanProcs('function Main()'+hb_eol()+'return nil'+hb_eol()+'function ; // declaration continues'+hb_eol()+'/* gap */ Target()'+hb_eol()+'return nil')
 Check(Len(a)==2.and.a[2,1]=='Target'.and.a[2,3]==3,'continued declaration preserves first physical line',@nPass,@nFail)
 a:=HBIDE_ScanProcs('static ;'+hb_eol()+'function ;'+hb_eol()+'Target()')
 Check(Len(a)==1.and.a[1,1]=='Target'.and.a[1,3]==1,'multiple declaration continuations preserve first line',@nPass,@nFail)
 a:=HBIDE_ScanProcs('function ;'+hb_eol()+'// intervening comment'+hb_eol()+'Target()')
 Check(Len(a)==1.and.a[1,1]=='Target'.and.a[1,3]==1,'line comment between declaration parts ignored',@nPass,@nFail)
 a:=HBIDE_ScanProcs('function Main()'+hb_eol()+'local x := ";"'+hb_eol()+'function Target()')
 Check(Len(a)==2.and.a[2,3]==3,'literal semicolon not declaration continuation',@nPass,@nFail)
 a:=HBIDE_ScanProcs('function ;'+hb_eol()+'#define X 1'+hb_eol()+'function Target()')
 Check(Len(a)==1.and.a[1,1]=='Target'.and.a[1,3]==3,'directive drops pending incomplete declaration',@nPass,@nFail)
 a:=HBIDE_ScanProcs('function;'+hb_eol()+'Target()')
 Check(Len(a)==1.and.a[1,1]=='Target'.and.a[1,3]==1,'compact function continuation',@nPass,@nFail)
 a:=HBIDE_ScanProcs('static;'+hb_eol()+'function;'+hb_eol()+'Target()')
 Check(Len(a)==1.and.a[1,1]=='Target'.and.a[1,3]==1,'compact modifier and function continuations',@nPass,@nFail)
 a:=HBIDE_ScanProcs('method;'+hb_eol()+'Target() CLASS Demo')
 Check(Len(a)==1.and.a[1,1]=='Demo:Target'.and.a[1,3]==1,'compact method continuation',@nPass,@nFail)
 for each c in { 'STAT', 'STATI', 'STATIC' }
 a:=HBIDE_ScanProcs(c+';'+hb_eol()+'function Target()')
 Check(Len(a)==1.and.a[1,1]=='Target'.and.a[1,3]==1.and.a[1,2]=='static function','static abbreviation continuation starts at modifier: '+c,@nPass,@nFail)
 next
 a:=HBIDE_ScanProcs('STAT function Target()')
 Check(Len(a)==1.and.a[1,2]=='static function','single-line static abbreviation remains recognized',@nPass,@nFail)
 a:=HBIDE_ScanProcs('TIC function Hidden()'+hb_eol()+'function Target()')
 Check(Len(a)==1.and.a[1,1]=='Target','modifier substring is not a keyword',@nPass,@nFail)
 a:=HBIDE_ScanProcs('CREATE CLASS Target'+hb_eol()+'ENDCLASS')
 Check(Len(a)==1.and.a[1,1]=='Target'.and.a[1,2]=='class'.and.a[1,3]==1,'CREATE CLASS alias indexed',@nPass,@nFail)
 a:=HBIDE_ScanProcs('CREATE;'+hb_eol()+'CLASS Target')
 Check(Len(a)==1.and.a[1,1]=='Target'.and.a[1,3]==1,'continued CREATE CLASS alias indexed at first line',@nPass,@nFail)
 a:=HBIDE_ScanProcs('CREATE TABLE hidden'+hb_eol()+'CREATE CLASS Target')
 Check(Len(a)==1.and.a[1,1]=='Target','other CREATE commands not class declarations',@nPass,@nFail)
 a:=HBIDE_ScanProcs('CLASS VAR hidden'+hb_eol()+'CLASS METHOD hidden'+hb_eol()+'CREATE CLASS Target')
 Check(Len(a)==1.and.a[1,1]=='Target','class members remain excluded with CREATE alias',@nPass,@nFail)
 a:=HBIDE_ScanProcs('ACCESS Value() CLASS Demo'+hb_eol()+'return 1'+hb_eol()+'ASSIGN Value(n) CLASS Demo')
 Check(Len(a)==2.and.a[1,1]=='Demo:Value'.and.a[1,3]==1,'ACCESS explicit class implementation indexed',@nPass,@nFail)
 Check(Len(a)==2.and.a[2,1]=='Demo:_Value'.and.a[2,3]==3,'ASSIGN implementation uses actual underscore method name',@nPass,@nFail)
 a:=HBIDE_ScanProcs('CLASS Demo'+hb_eol()+'ACCESS Value()'+hb_eol()+'ASSIGN Value(n)'+hb_eol()+'ENDCLASS')
 Check(Len(a)==1.and.a[1,1]=='Demo','member ACCESS ASSIGN declarations not implementations',@nPass,@nFail)
 a:=HBIDE_ScanProcs('ACCESS;'+hb_eol()+'Value() CLASS Demo')
 Check(Len(a)==1.and.a[1,1]=='Demo:Value'.and.a[1,3]==1,'ACCESS continuation preserves first line',@nPass,@nFail)
 a:=HBIDE_ScanProcs('// ACCESS Hidden() CLASS Demo'+hb_eol()+'ASSIGN Value(n) CLASS Demo')
 Check(Len(a)==1.and.a[1,1]=='Demo:_Value','commented accessor excluded',@nPass,@nFail)
 a:=HBIDE_ScanProcs('PROCEDURE Touch() CLASS Demo')
 Check(Len(a)==1.and.a[1,1]=='Demo:Touch'.and.a[1,2]=='method','PROCEDURE CLASS alias qualified as method',@nPass,@nFail)
 a:=HBIDE_ScanProcs('PROCEDURE Plain()')
 Check(Len(a)==1.and.a[1,1]=='Plain'.and.a[1,2]=='procedure','ordinary procedure remains unqualified',@nPass,@nFail)
 a:=HBIDE_ScanProcs('PROCEDURE;'+hb_eol()+'Touch() CLASS Demo')
 Check(Len(a)==1.and.a[1,1]=='Demo:Touch'.and.a[1,3]==1,'continued procedure method starts at first line',@nPass,@nFail)
 a:=HBIDE_ScanProcs('PROCEDURE Plain() // CLASS Wrong')
 Check(Len(a)==1.and.a[1,1]=='Plain'.and.a[1,2]=='procedure','commented CLASS not method qualifier',@nPass,@nFail)
 a:=HBIDE_ScanProcs('DESTRUCTOR Cleanup() CLASS Demo')
 Check(Len(a)==1.and.a[1,1]=='Demo:Cleanup'.and.a[1,2]=='method','explicit destructor implementation indexed',@nPass,@nFail)
 a:=HBIDE_ScanProcs('CLASS Demo'+hb_eol()+'DESTRUCTOR Cleanup()'+hb_eol()+'ENDCLASS')
 Check(Len(a)==1.and.a[1,1]=='Demo','member destructor declaration not implementation',@nPass,@nFail)
 a:=HBIDE_ScanProcs('DESTRUCTOR FUNCTION External()')
 Check(Len(a)==0,'external function destructor binding not declaration',@nPass,@nFail)
 a:=HBIDE_ScanProcs('DESTRUCTOR;'+hb_eol()+'Cleanup() CLASS Demo')
 Check(Len(a)==1.and.a[1,1]=='Demo:Cleanup'.and.a[1,3]==1,'destructor continuation retains first line',@nPass,@nFail)
 for each c in { 'NOTE /* ignored', 'note/* ignored', Chr(9)+'NoTe /* ignored' }
 a:=HBIDE_ScanProcs('function Main()'+hb_eol()+c+hb_eol()+'function Target()')
 Check(Len(a)==2.and.a[2,1]=='Target'.and.a[2,3]==3,'NOTE line does not start block: '+c,@nPass,@nFail)
 next
 a:=HBIDE_ScanProcs('NOTEBOOK := 1 /* real'+hb_eol()+'function Hidden()'+hb_eol()+'*/'+hb_eol()+'function Target()')
 Check(Len(a)==1.and.a[1,1]=='Target','NOTE identifier prefix is not comment',@nPass,@nFail)
 for each c in { 'INIT', 'EXIT', 'STATIC', 'STAT' }
 a:=HBIDE_ScanProcs(c+' PROCEDURE Target()')
 Check(Len(a)==1.and.a[1,2]==iif(Left(c,4)=='STAT','static',Lower(c))+' procedure','modifier kind retained: '+c,@nPass,@nFail)
 next
 a:=HBIDE_ScanProcs('INIT;'+hb_eol()+'PROCEDURE Startup()'+hb_eol()+'EXIT;'+hb_eol()+'PROCEDURE Cleanup()')
 Check(Len(a)==2.and.a[1,2]=='init procedure'.and.a[1,3]==1.and.a[2,2]=='exit procedure'.and.a[2,3]==3,'continued lifecycle modifiers keep kind and start line',@nPass,@nFail)
 for each c in { 'METHOD Ping()CLASS Demo', 'METHOD FUNCTION Ping()CLASS Demo', 'METHOD PROCEDURE Ping()CLASS Demo', 'PROCEDURE Ping()CLASS Demo', 'ACCESS Ping()CLASS Demo', 'DESTRUCTOR Ping()CLASS Demo' }
 a:=HBIDE_ScanProcs(c)
 Check(Len(a)==1.and.a[1,1]=='Demo:Ping'.and.a[1,2]=='method'.and.a[1,3]==1,'compact argument/class boundary: '+c,@nPass,@nFail)
 next
 a:=HBIDE_ScanProcs('ASSIGN Value(n)CLASS Demo')
 Check(Len(a)==1.and.a[1,1]=='Demo:_Value','compact assign retains underscore method name',@nPass,@nFail)
 a:=HBIDE_ScanProcs('METHOD Ping()CLASS;'+hb_eol()+'Demo')
 Check(Len(a)==1.and.a[1,1]=='Demo:Ping'.and.a[1,3]==1,'compact qualifier continuation retains declaration line',@nPass,@nFail)
 ? 'TOTAL',nPass,'PASS',nFail,'FAIL'
 ErrorLevel(iif(nFail==0,0,1))
return
procedure Check(ok,name,nPass,nFail)
 if ok;nPass++;else;nFail++;endif
 ? iif(ok,'PASS:','FAIL:'),name
return
function HBDlgTitleColor()
return 'W+/W'
procedure DrawShadow(t,l,b,r)
 HB_SYMBOL_UNUSED(t)
 HB_SYMBOL_UNUSED(l)
 HB_SYMBOL_UNUSED(b)
 HB_SYMBOL_UNUSED(r)
return
