#include "hbclass.ch"
PROCEDURE Main()
   LOCAL o := HBSrcEdit():New( 'aaaa', 2, 1, 20, 79, .T. )
   LOCAL nPass := 0, nFail := 0
   o:GoTo( 1, 5 )
   o:FindText( 'a' )
   Check( 'first search finds next character at column6', o:Col() == 6, @nPass, @nFail )
   o:FindNext()
   Check( 'repeat finds adjacent match at column7, never skips it', o:Col() == 7, @nPass, @nFail )
   o:FindNext()
   Check( 'repeat finds final match at column8', o:Col() == 8, @nPass, @nFail )
   o:FindNext()
   Check( 'repeat wraps within same line to column5', o:Col() == 5, @nPass, @nFail )
   o:LoadText( 'only' )
   o:GoTo( 1, 5 )
   o:FindText( 'missing' )
   Check( 'missing search retains cursor', o:Col() == 5, @nPass, @nFail )
   o:FindNext()
   Check( 'missing repeat retains cursor', o:Col() == 5, @nPass, @nFail )
   o:LoadText( 'banana' )
   o:GoTo( 1, 5 )
   o:FindText( 'ana' )
   Check( 'overlap first match at column6', o:Col() == 6, @nPass, @nFail )
   o:FindNext()
   Check( 'overlap next match at column8', o:Col() == 8, @nPass, @nFail )
   o:FindNext()
   Check( 'overlap wraps to first match', o:Col() == 6, @nPass, @nFail )
   o:LoadText( 'match' + hb_eol() + 'middle' + hb_eol() + 'match' )
   o:GoTo( 2, 5 )
   o:FindText( 'MATCH' )
   Check( 'case insensitive forward reaches third line', o:RowPos() == 3 .and. o:Col() == 5, @nPass, @nFail )
   o:FindNext()
   Check( 'multiline wraps to first line', o:RowPos() == 1 .and. o:Col() == 5, @nPass, @nFail )
   o:LoadText( 'single' )
   o:GoTo( 1, 5 )
   o:FindText( 'single' )
   o:FindNext()
   Check( 'single match wraps to itself', o:Col() == 5, @nPass, @nFail )
   ? 'TOTAL', nPass, 'PASS', nFail, 'FAIL'
   ErrorLevel( iif( nFail == 0, 0, 1 ) )
   RETURN
PROCEDURE Check( cName, lOk, nPass, nFail )
   nPass += iif( lOk, 1, 0 )
   nFail += iif( lOk, 0, 1 )
   ? iif( lOk, 'PASS:', 'FAIL:' ), cName
   RETURN
FUNCTION HBIDE_MsgAlert( cText )
   HB_SYMBOL_UNUSED( cText )
   RETURN 1
