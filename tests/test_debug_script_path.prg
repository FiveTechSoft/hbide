PROCEDURE Main()
   LOCAL cOldPath:=GetEnv("PATH"),cRoot:=hb_cwd(),cDir:=cRoot+"path with spaces"+hb_ps(),cSecond:=cRoot+"second"+hb_ps(),cSep:=hb_osPathListSeparator()
   hb_DirCreate(cDir)
   hb_SetEnv("PATH",cDir)
   hb_MemoWrit(cDir+"sample.cld","Options Tab 11")
   Check(HBIDE_DbgScriptPath("sample")==cDir+"sample.cld","PATH default extension")
   Check(HBIDE_DbgScriptPath("sample.cld")==cDir+"sample.cld","PATH explicit extension")
   hb_MemoWrit("sample.cld","Options Tab 7")
   Check(HBIDE_DbgScriptPath("sample")=="sample.cld","cwd precedence")
   Check(Empty(HBIDE_DbgScriptPath("missing")),"missing")
   Check(Empty(HBIDE_DbgScriptPath("elsewhere"+hb_ps()+"sample")),"explicit dir no basename fallback")
   hb_MemoWrit(cDir+" leading.cld","Options Tab 9")
   Check(HBIDE_DbgScriptPath(" leading")==cDir+" leading.cld","leading filename preserved")
   hb_MemoWrit(cDir+"other.custom","Options Tab 3")
   Check(HBIDE_DbgScriptPath("other.custom")==cDir+"other.custom","explicit extension preserved")
   Check(Empty(HBIDE_DbgScriptPath(NIL)),"nil")
   Check(Empty(HBIDE_DbgScriptPath("")),"empty")
   hb_DirCreate(cSecond)
   hb_MemoWrit(cSecond+"ordered.cld","second")
   hb_MemoWrit(cDir+"ordered.cld","first")
   hb_SetEnv("PATH",cDir+cSep+cSecond)
   Check(HBIDE_DbgScriptPath("ordered")==cDir+"ordered.cld","PATH first candidate")
   hb_SetEnv("PATH",cSecond+cSep+cDir)
   Check(HBIDE_DbgScriptPath("ordered")==cSecond+"ordered.cld","PATH order reversed")
   hb_SetEnv("PATH",cSep+cSep+cDir+cSep)
   Check(HBIDE_DbgScriptPath("ordered")==cDir+"ordered.cld","empty PATH components")
   Check(HBIDE_DbgScriptPath(cDir+"sample")==cDir+"sample.cld","explicit absolute default extension")
   Check(HBIDE_DbgScriptPath("path with spaces"+hb_ps()+"sample")=="path with spaces"+hb_ps()+"sample.cld","explicit relative default extension")
   hb_MemoWrit("ordered","extensionless neighbor")
   Check(HBIDE_DbgScriptPath("ordered")==cDir+"ordered.cld","default extension never picks extensionless neighbor")
   hb_MemoWrit(cDir+"literal.cld ","trailing filename")
   Check(HBIDE_DbgScriptPath("literal.cld ")==cDir+"literal.cld ","explicit trailing space preserved")
   hb_SetEnv("PATH","")
   Check(Empty(HBIDE_DbgScriptPath("ordered")),"empty PATH does not invent root search")
   Check(HBIDE_DbgScriptPath("sample")=="sample.cld","cwd with empty PATH")
   hb_SetEnv("PATH",cOldPath)
   ? "PASS script lookup 18 checks"
   RETURN
STATIC PROCEDURE Check(lOk,cName)
   IF ! lOk
      ? "FAIL",cName
      ErrorLevel(1)
      QUIT
   ENDIF
   RETURN
