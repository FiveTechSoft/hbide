#include 'hbclass.ch'
#include 'inkey.ch'
#include 'setcurs.ch'

function Dlg_ResizeDemo()

   local oDlg, GetList := {}, lOk := .F.
   local cNombre := Space( 17 )
   local nLista := 1
   local aItems3
   local lDummy

   oDlg = HBWindow():Dialog( "Resize Demo", 70, 24, "W+/B" )

   __ClsModMsg( PushButton( 0, 0 ):ClassH, 'DISPLAY', @DsnBtnDisplay() )

   aItems3 := { "Alpha", "Beta", "Gamma", "Delta" }

   hb_DispOutAt( oDlg:nTop + 3, oDlg:nLeft + 4, "Nombre:", 'W+/B' )
   @ oDlg:nTop + 3, oDlg:nLeft + 12 GET cNombre COLOR 'N/W,B/W,N/W,GR+/W'
   @ oDlg:nTop + 6, oDlg:nLeft + 4, oDlg:nTop + 13, oDlg:nLeft + 21 GET nLista LISTBOX aItems3 COLOR 'N/W,W+/N,N/W,W+/G,N/W,W+/W,GR+/W'
   @ oDlg:nTop + 21, oDlg:nLeft + 4 GET lDummy PUSHBUTTON CAPTION "&Aceptar" ;
      COLOR 'N/W,W+/N,N/W,R/W' STATE { || lOk := .T., oDlg:End() }
   @ oDlg:nTop + 21, oDlg:nLeft + 17 GET lDummy PUSHBUTTON CAPTION "&Cancelar" ;
      COLOR 'N/W,W+/N,N/W,R/W' STATE { || lOk := .T., oDlg:End() }

   oDlg:Activate( GetList )

return lOk

// pushbutton display override: same 3D look as hbbutton's BtnDisplay,
// with the shadow painted on the dialog background
function DsnBtnDisplay()

   local Self := QSelf()

   local cColor
   local cStyle := DsnBtnPads()
   local cCaption := ::cCaption
   local nRow := ::nRow
   local nCol := ::nCol
   local nPos

   DispBegin()

   do case
   case ::lBuffer
      cColor := hb_ColorIndex( ::cColorSpec, 2 )
   case ::lHasFocus
      cColor := hb_ColorIndex( ::cColorSpec, 1 )
   otherwise
      cColor := hb_ColorIndex( ::cColorSpec, 0 )
   endcase

   if ( nPos := At( "&", cCaption ) ) == 0
   elseif nPos == Len( cCaption )
      nPos := 0
   else
      cCaption := Stuff( cCaption, nPos, 1, "" )
   endif

   if ! Empty( cStyle )

      nCol++

      if ::lBuffer
         hb_DispOutAt( ::nRow, ::nCol, " ", "N/B" )
      endif
      hb_DispOutAt( ::nRow, ::nCol + If( ::lBuffer, 1, 0 ), cStyle[ 1 ], cColor )
      hb_DispOutAt( ::nRow, ::nCol + Len( cCaption ) + 1 + If( ::lBuffer, 1, 0 ), cStyle[ 2 ], cColor )
   endif

   if ! Empty( cCaption )

      hb_DispOutAt( nRow, nCol + If( ::lBuffer, 1, 0 ), cCaption, cColor )

      if nPos != 0
         hb_DispOutAt( nRow, nCol + nPos - 1 + If( ::lBuffer, 1, 0 ),;
                       SubStr( cCaption, nPos, 1 ), hb_ColorIndex( ::cColorSpec, 3 ) )
      endif
   endif

   hb_DispOutAt( nRow, ::nCol + Len( cCaption ) + 2 + If( ::lBuffer, 1, 0 ),;
                 If( ::lBuffer, " ", DsnBtnShades()[ 1 ] ), "N/B" )
   hb_DispOutAt( ::nRow + 1, ::nCol + 1,;
                 Replicate( If( ::lBuffer, " ", DsnBtnShades()[ 2 ] ), Len( cCaption ) + 2 ), "N/B" )

   DispEnd()

return Self

// caption pads and shadow half blocks follow the active codepage:
// CP437 keeps the raw bytes, the UTF-8 opt-in gets valid encodings
function DsnBtnPads()

return { hb_UTF8ToStr( " " ), hb_UTF8ToStr( " " ) }

function DsnBtnShades()

return { hb_UTF8ToStr( "▄" ), hb_UTF8ToStr( "▀" ) }
