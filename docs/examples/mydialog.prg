#include 'hbclass.ch'
#include 'inkey.ch'
#include 'setcurs.ch'

function Dlg_MyDialog()

   local oDlg, GetList := {}, lOk := .F.
   local cVar2 := Space( 10 )
   local lVar3 := .F.
   local lDummy

   oDlg = HBWindow():Dialog( "My Dialog", 41, 13, "W+/W" )

   oDlg:Say( 3, 5, "Label" )
   @ oDlg:nTop + 5, oDlg:nLeft + 5 GET cVar2
   @ oDlg:nTop + 7, oDlg:nLeft + 5 GET lVar3 CHECKBOX CAPTION "Check"
   @ oDlg:nTop + 10, oDlg:nLeft + 5 GET lDummy PUSHBUTTON CAPTION "&OK" ;
      COLOR 'GR+/G,W+/G,N/G,BG+/G' STATE { || lOk := .T., oDlg:End() }

   oDlg:Activate( GetList )

return lOk
